{
  "name": "@noahsoft/pernorama",
  "version": "0.1.0",
  "description": "Framework-independent permission nodes, contexts, roles and decision explanations. The TypeScript SDK of Pernorama.",
  "license": "MIT",
  "author": "NOAHSOFT",
  "homepage": "https://github.com/NOAHSOFTKR/pernorama/tree/main/typescript#readme",
  "bugs": "https://github.com/NOAHSOFTKR/pernorama/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOAHSOFTKR/pernorama.git",
    "directory": "typescript"
  },
  "keywords": [
    "permissions",
    "authorization",
    "rbac",
    "roles",
    "access-control"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"build/test/test/**/*.test.js\"",
    "test:conformance": "tsc -p tsconfig.test.json && node --test \"build/test/test/conformance/*.test.js\"",
    "check:package": "node scripts/check-package.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:package && npm run smoke",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
