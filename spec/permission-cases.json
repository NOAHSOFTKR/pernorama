  "ruleSets": [
    {
      "name": "default deny: no rules cover nothing",
      "rules": [],
      "checks": [
        {
          "node": "users.create",
          "decision": "NOT_COVERED",
          "explanation": { "allowed": false, "decision": "NOT_COVERED", "provenance": "COMPLETE" }
        }
      ]
    },
    {
      "name": "exact rule covers exactly its own node",
      "rules": ["users.create"],
      "checks": [
        {
          "node": "users.create",
          "decision": "PERMITTED",
          "explanation": {
            "allowed": true,
            "decision": "PERMITTED",
            "provenance": "COMPLETE",
            "matches": [{ "rule": "users.create", "decisive": true }]
          }
        },
        { "node": "users.delete", "decision": "NOT_COVERED" },
        { "node": "users", "decision": "NOT_COVERED" },
        { "node": "users.create.draft", "decision": "NOT_COVERED" },
        { "node": "Users.create", "decision": "NOT_COVERED" }
      ]
    },
    {
      "name": "trailing wildcard covers its prefix and everything under it",
      "rules": ["users.*"],
      "checks": [
        { "node": "users", "decision": "PERMITTED" },
        { "node": "users.create", "decision": "PERMITTED" },
        { "node": "users.profile.edit", "decision": "PERMITTED" },
        { "node": "userss", "decision": "NOT_COVERED" },
        { "node": "user", "decision": "NOT_COVERED" },
        { "node": "orders.users", "decision": "NOT_COVERED" }
      ]
    },
    {
      "name": "root wildcard covers every node",
      "rules": ["*"],
      "checks": [
        {
          "node": "anything.at.all",
          "decision": "PERMITTED",
          "explanation": {
            "allowed": true,
            "decision": "PERMITTED",
            "provenance": "COMPLETE",
            "matches": [{ "rule": "*", "decisive": true, "wildcard": true }]
          }
        },
        { "node": "x", "decision": "PERMITTED" }
      ]
    },
    {
      "name": "an exact deny carves one node out of a wildcard allow",
      "rules": ["users.*", "-users.delete"],
      "checks": [
        { "node": "users.create", "decision": "PERMITTED" },
        {
          "node": "users.delete",
          "decision": "DENIED",
          "explanation": {
            "allowed": false,
            "decision": "DENIED",
            "provenance": "COMPLETE",
            "matches": [
              { "rule": "-users.delete", "decisive": true, "deny": true },
              { "rule": "users.*", "wildcard": true }
            ]
          }
        },
        { "node": "users.delete.hard", "decision": "PERMITTED" },
        { "node": "orders.read", "decision": "NOT_COVERED" }
      ]
    },
    {
      "name": "an exact allow re-opens one node inside a wildcard deny",
      "rules": ["-users.*", "users.read"],
      "checks": [
        { "node": "users.read", "decision": "PERMITTED" },
        { "node": "users.write", "decision": "DENIED" },
        { "node": "users", "decision": "DENIED" },
        { "node": "users.read.all", "decision": "DENIED" },
        { "node": "orders.read", "decision": "NOT_COVERED" }
      ]
    },
    {
      "name": "deny wins a tie between equally specific rules, in either order",
      "rules": ["users.delete", "-users.delete", "-orders.*", "orders.*"],
      "checks": [
        {
          "node": "users.delete",
          "decision": "DENIED",
          "explanation": {
            "allowed": false,
            "decision": "DENIED",
            "provenance": "COMPLETE",
            "matches": [
              { "rule": "-users.delete", "decisive": true, "deny": true },
              { "rule": "users.delete" }
            ]
          }
        },
        { "node": "orders.read", "decision": "DENIED" },
        { "node": "orders", "decision": "DENIED" }
      ]
    },
    {
      "name": "deny wins a tie at the root",
      "rules": ["*", "-*"],
      "checks": [
        {
          "node": "x",
          "decision": "DENIED",
          "explanation": {
            "allowed": false,
            "decision": "DENIED",
            "provenance": "COMPLETE",
            "matches": [
              { "rule": "-*", "decisive": true, "deny": true, "wildcard": true },
              { "rule": "*", "wildcard": true }
            ]
          }
        }
      ]
    },
    {
      "name": "the most specific covering rule decides, through four levels",
      "rules": ["*", "-users.*", "users.profile.*", "-users.profile.delete"],
      "checks": [
        { "node": "orders.read", "decision": "PERMITTED" },
        { "node": "users.list", "decision": "DENIED" },
        { "node": "users", "decision": "DENIED" },
        { "node": "users.profile", "decision": "PERMITTED" },
        { "node": "users.profile.edit", "decision": "PERMITTED" },
        {
          "node": "users.profile.delete",
          "decision": "DENIED",
          "explanation": {
            "allowed": false,
            "decision": "DENIED",
            "provenance": "COMPLETE",
            "matches": [
              { "rule": "-users.profile.delete", "decisive": true, "deny": true },
              { "rule": "users.profile.*", "wildcard": true },
              { "rule": "-users.*", "deny": true, "wildcard": true },
              { "rule": "*", "wildcard": true }
            ]
          }
        },
        { "node": "users.profile.delete.now", "decision": "PERMITTED" }
      ]
    },
    {
      "name": "an exact rule beats a wildcard rooted at the same node",
      "rules": ["-a.b.*", "a.b"],
      "checks": [
        { "node": "a.b", "decision": "PERMITTED" },
        { "node": "a.b.c", "decision": "DENIED" }
      ]
    },
    {
      "name": "an exact deny beats a wildcard allow rooted at the same node",
      "rules": ["a.b.*", "-a.b"],
      "checks": [
        { "node": "a.b", "decision": "DENIED" },
        { "node": "a.b.c", "decision": "PERMITTED" }
      ]
    },
    {
      "name": "a wildcard deny removes the node and its whole subtree",
      "rules": ["users.*", "-users.delete.*"],
      "checks": [
        { "node": "users.delete", "decision": "DENIED" },
        { "node": "users.delete.hard", "decision": "DENIED" },
        { "node": "users.deleted", "decision": "PERMITTED" }
      ]
    },
    {
      "name": "a repeated rule is reported once per occurrence, each decisive",
      "rules": ["users.*", "users.*"],
      "checks": [
        {
          "node": "users.x",
          "decision": "PERMITTED",
          "explanation": {
            "allowed": true,
            "decision": "PERMITTED",
            "provenance": "COMPLETE",
            "matches": [
              { "rule": "users.*", "decisive": true, "wildcard": true },
              { "rule": "users.*", "decisive": true, "wildcard": true }
            ]
          }
        }
      ]
    },
    {
      "name": "an invalid rule anywhere is reported, even after a covering rule",
      "rules": ["users.create", "users.*.read"],
      "checks": [{ "node": "users.create", "error": "INVALID_PERMISSION" }]
    },
    {
      "name": "a null rule is invalid",
      "rules": ["users.create", null],
      "checks": [{ "node": "users.create", "error": "INVALID_PERMISSION" }]
    },
    {
      "name": "the checked value has to be a node, not a rule",
      "rules": ["users.*", "-users.read"],
      "checks": [
        { "node": "users.*", "error": "INVALID_PERMISSION" },
        { "node": "-users.read", "error": "INVALID_PERMISSION" },
        { "node": "*", "error": "INVALID_PERMISSION" },
        { "node": "", "error": "INVALID_PERMISSION" },
        { "node": null, "error": "INVALID_PERMISSION" },
        { "node": "users..read", "error": "INVALID_PERMISSION" }
      ]
    }
  ]
}
